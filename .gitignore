# build output
dist/
.output/
.vercel/
.netlify/

# generated types and caches (Astro)
.astro/

# dependencies
node_modules/

# logs
logs/
*.log
.dev.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.local
.env.*.local

# EmDash CMS
# data.db holds the content model, entries, users and settings.
# uploads/ holds media binaries. A database backup does not include them —
# back the directory up separately.
data.db
data.db-shm
data.db-wal
uploads/

# EmDash build output. migrations.json is a validated, secret-free manifest of
# the core migrations, generated by `astro build` and meant to be committed so
# CI can apply migrations without a runtime migration pass. Everything else in
# here is regenerable.
.emdash/*
!.emdash/migrations.json

# testing
coverage/

# macOS-specific files
.DS_Store

# Windows-specific files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# jetbrains setting folder
.idea/

# Local VS Code settings (extensions.json / launch.json stay tracked)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json