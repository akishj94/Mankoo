---
import Layout from '../../layouts/Layout.astro';
import Media from '../../components/Media.astro';
import Pagination from '../../components/Pagination.astro';
import { getProducts } from '../../lib/queries';
import { text } from '../../lib/cms';

const PRODUCTS_PER_PAGE = 12;

const { products, cacheHint } = await getProducts();

if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

const totalPages = Math.max(1, Math.ceil(products.length / PRODUCTS_PER_PAGE));
const requested = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const page = Math.min(Math.max(Number.isNaN(requested) ? 1 : requested, 1), totalPages);
const pageProducts = products.slice((page - 1) * PRODUCTS_PER_PAGE, page * PRODUCTS_PER_PAGE);

const pageUrl = (target: number) => (target <= 1 ? '/products' : `/products?page=${target}`);
---

<Layout title="Products" description="Power presses, forging presses, shearing machines and forge hammers built by Mankoo India in Ludhiana.">
  <section class="container py-24">
    <h1 data-reveal class="text-3xl font-semibold tracking-tight">Products</h1>
    <p data-reveal class="mt-4 max-w-xl text-neutral-600">
      Machines built and trial-run in Ludhiana before they ship.
    </p>

    {products.length === 0 && (
      <p data-reveal class="mt-16 text-sm text-neutral-500">
        No products have been published yet.
      </p>
    )}

    <div class="mt-16 grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {pageProducts.map((product) => (
        <a
          href={`/products/${product.id}`}
          class="group/post block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
        >
          <Media
            image={product.data.cover_image ?? null}
            alt={text(product.data.cover_alt, text(product.data.title))}
            ratio="16/9"
            widths={[408, 640, 816]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
            class="bg-neutral-100"
            mediaClass="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover/post:scale-110 group-focus-visible/post:scale-110"
          />

          <p class="mt-6 text-[11px] uppercase tracking-[0.2em] text-neutral-500">
            Machines
          </p>

          <h2 class="mt-4 text-[18px] leading-[1.3] tracking-tight text-ink">
            {text(product.data.title)}
          </h2>

          {product.data.excerpt && (
            <p class="mt-3 text-[15px] leading-relaxed text-neutral-600">
              {product.data.excerpt}
            </p>
          )}
        </a>
      ))}
    </div>

    {totalPages > 1 && <Pagination page={page} totalPages={totalPages} getHref={pageUrl} />}
  </section>
</Layout>
