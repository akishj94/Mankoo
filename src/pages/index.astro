---
import Layout from '../layouts/Layout.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { getPage } from '../lib/queries';
import { homeFallback } from '../lib/fallbacks';
import { text } from '../lib/cms';

const { entry: page, cacheHint } = await getPage('home');

if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

const layout = page?.data.layout;
---

<Layout title={text(page?.data.title)} description={page?.data.description}>
  <PageBlocks layout={layout?.length ? layout : homeFallback} />
</Layout>
