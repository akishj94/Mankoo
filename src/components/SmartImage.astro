---
import { Image as AstroImage } from 'astro:assets';
import { Image as EmDashImage } from 'emdash/ui';
import type { ImageMetadata } from 'astro';

function isLocalAsset(value: unknown): value is ImageMetadata {
  if (typeof value !== 'object' || value === null) return false;
  if ('id' in value) return false;

  return 'src' in value && 'width' in value && 'height' in value && 'format' in value;
}

export interface Props {
  src: ImageMetadata | string | undefined | null;
  alt?: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  priority?: boolean;
  class?: string;
}

const { src, alt = '', priority, ...passthrough } = Astro.props;
---

{isLocalAsset(src) ? (
  <AstroImage src={src} alt={alt} {...passthrough} />
) : src ? (
  <EmDashImage image={src} alt={alt} priority={priority} {...passthrough} />
) : (
  <div
    aria-hidden="true"
    class:list={['bg-neutral-900', passthrough.class]}
  />
)}
