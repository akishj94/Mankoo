---
import ProductCarousel from '../sections/ProductCarousel.astro';
import { text, type Block } from '../../lib/cms';

interface Props {
  value: Block<Record<string, unknown>>;
}

const { value } = Astro.props;

const authored = (value.slides as Record<string, unknown>[] | undefined) ?? [];
const slides = authored
  .map((slide) => ({
    href: text(slide.href),
    image: slide.image as never,
    alt: text(slide.alt, text(slide.title)),
    title: text(slide.title),
    description: '',
  }))
  .filter((slide) => slide.title);
---

<ProductCarousel
  eyebrow={text(value.eyebrow)}
  title={text(value.title)}
  viewAllHref={text(value.view_all_href)}
  viewAllLabel={text(value.view_all_label)}
  {slides}
/>