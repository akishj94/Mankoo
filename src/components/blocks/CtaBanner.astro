---
import CtaBanner from '../sections/CtaBanner.astro';
import { text, type Block } from '../../lib/cms';

interface Props {
  value: Block<Record<string, unknown>>;
}

const { value } = Astro.props;

const image = (value.image ?? null) as never;
---

<CtaBanner
  title={text(value.title)}
  text={text(value.text)}
  ctaHref={text(value.cta_href)}
  ctaLabel={text(value.cta_label)}
  {image}
  imageAlt={text(value.image_alt, text(value.title))}
/>
