---
import { homeReasons } from '../../lib/fallbacks';
import { text, type Block } from '../../lib/cms';

interface Props {
  value: Block<Record<string, unknown>>;
}

const { value } = Astro.props;

const authored = (value.items as Record<string, unknown>[] | undefined) ?? [];
const picked = authored
  .map((item) => ({ title: text(item.title) }))
  .filter((reason) => reason.title);

const reasons = picked.length > 0 ? picked : homeReasons;
const title = text(value.title);
---

{reasons.length > 0 && (
  <section class="bg-white text-neutral-900">
    <div class="container py-24">
      {title && (
        <h2
          class="mt-4 text-[32px] leading-[1.08] tracking-tight text-[clamp(30px,4vw,56.5px)]"
          data-reveal
        >
          {title}
        </h2>
      )}

      <div class="mt-23 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {reasons.map((reason, i) => (
          <div class="border-t border-2x-[#CACACA] pt-5" data-reveal>
            <span class="text-sm text-orange-500">{String(i + 1).padStart(2, '0')}</span>
            <p class="mt-3 text-[20px] leading-snug lg:max-w-[80%]">{reason.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
