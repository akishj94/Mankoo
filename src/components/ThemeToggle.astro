---

interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<button
  type="button"
  id={id}
  data-theme-toggle
  aria-label="Switch to light theme"
  aria-pressed="false"
  title="Toggle light / dark theme"
  class:list={[
    'grid size-10 shrink-0 cursor-pointer place-items-center rounded-full transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current light:hover:bg-ink/5',
    className,
  ]}
>
  <svg
    data-theme-icon="moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="hidden light:block"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
  </svg>
  <svg
    data-theme-icon="sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="block light:hidden"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
  </svg>
</button>
