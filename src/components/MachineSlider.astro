---
// Only Swiper's core stylesheet is imported. The navigation buttons and
// pagination bullets are styled by hand below, so the bundled themes are
// deliberately left out to keep the section on-brand.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import 'swiper/css';

interface Slide {
  /** Destination of the whole slide. */
  href: string;
  /** Imported from src/assets so Astro can optimise it — see index.astro. */
  image: ImageMetadata;
  alt: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  viewAllHref?: string;
  viewAllLabel?: string;
  slides: Slide[];
}

const {
  eyebrow = 'Our range',
  title = 'Machines',
  viewAllHref = '/machines',
  viewAllLabel = 'View all',
  slides,
} = Astro.props;
---

<!-- Desktop padding breathes with the viewport between 76px and 100px; the
     smaller breakpoints step down so the section doesn't swallow a phone. -->
<section data-slider class="bg-white py-14 text-ink sm:py-16 lg:py-[clamp(76px,5vw,100px)]">
  <div class="container">
    <!-- Heading row. `items-end` drops "View all" onto the bottom edge of the
         title block rather than centring it against the two-line stack. -->
    <div class="flex items-end justify-between gap-8" data-reveal>
      <div class="w-full min-w-0 md:max-w-[60%]">
        <p class="text-[14px] uppercase tracking-[0.2em] text-accent">
          {eyebrow}
        </p>

        <h2 class="mt-4 text-[32px] leading-[1.08] tracking-tight sm:text-[30px] md:text-[36px] lg:text-[42.5px]">
          {title}
        </h2>
      </div>

      <a
        href={viewAllHref}
        class="group/view-all inline-flex shrink-0 items-center gap-2 transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
      >
        {viewAllLabel}        
      </a>
    </div>

    <div class="mt-10 sm:mt-14">
      <div class="swiper" data-slider-root>
        <ul class="swiper-wrapper">
          {slides.map((slide) => (
            <li class="swiper-slide">
              <a
                href={slide.href}
                class="group/slide flex h-full flex-col focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
              >
                <div class="relative aspect-[4/5] w-full overflow-hidden bg-neutral-100">
                  <Image
                    src={slide.image}
                    alt={slide.alt}
                    width={800}
                    height={1000}
                    sizes="(min-width: 1536px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw"
                    loading="lazy"
                    decoding="async"
                    class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover/slide:scale-110 group-focus-visible/slide:scale-110"
                  />
                  <span
                    aria-hidden="true"
                    class="absolute left-5 bottom-5 grid size-12 translate-y-[calc(100%+1.25rem)] place-items-center rounded-full bg-[var(--color-body-bg)] text-white opacity-0 transition-[translate,opacity] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover/slide:translate-y-0 group-hover/slide:opacity-100 group-focus-visible/slide:translate-y-0 group-focus-visible/slide:opacity-100"
                  >
                    <svg width="18" height="13" viewBox="0 0 16 12" fill="none">
                      <path
                        d="M0 6h13.5M9 1l5 5-5 5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </div>

                <h3 class="mt-5 text-[20px] tracking-tight">
                  {slide.title}
                </h3>
                <p class="mt-2 max-w-[42ch] text-[15px] leading-[1.2] text-[#616161]">
                  {slide.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-10 flex items-center justify-center gap-6 sm:mt-12 lg:hidden">
        <div class="slider-pagination flex items-center" data-slider-pagination></div>

        <!-- Arrows are for touch-sized screens. From lg up the peek that makes
             this a slider is gone, so only the bullets remain. -->
        <div class="flex items-center gap-2 hidden">
          <button
            type="button"
            data-slider-prev
            aria-label="Previous machine"
            class="grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border border-ink/15 text-ink transition-colors hover:border-ink/40 hover:bg-ink/5 disabled:cursor-default disabled:border-ink/15 disabled:bg-transparent disabled:opacity-30 disabled:hover:border-ink/15 disabled:hover:bg-transparent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          >
            <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true" class="-scale-x-100">
              <path
                d="M0 6h13.5M9 1l5 5-5 5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <button
            type="button"
            data-slider-next
            aria-label="Next machine"
            class="grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border border-ink/15 text-ink transition-colors hover:border-ink/40 hover:bg-ink/5 disabled:cursor-default disabled:border-ink/15 disabled:bg-transparent disabled:opacity-30 disabled:hover:border-ink/15 disabled:hover:bg-transparent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          >
            <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
              <path
                d="M0 6h13.5M9 1l5 5-5 5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Swiper injects the bullets at runtime, so they never receive Astro's
     scoping attribute and have to be addressed through :global(). */
  .slider-pagination {
    gap: 0.5rem;
  }

  .slider-pagination :global(.swiper-pagination-bullet) {
    appearance: none;
    width: 1.5rem;
    height: 0.25rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    /* --color-ink at 18%. A literal rather than a color-mix() so it works
       everywhere, matching the plain rgba() used elsewhere in this file. */
    background-color: rgb(0 10 34 / 0.18);
    cursor: pointer;
    transition:
      width 0.45s cubic-bezier(0.32, 0.72, 0, 1),
      background-color 0.3s ease;
  }

  .slider-pagination :global(.swiper-pagination-bullet-active) {
    width: 2.75rem;
    background-color: var(--color-ink);
  }

  .slider-pagination :global(.swiper-pagination-bullet:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  /* watchOverflow locks the arrows once every slide already fits on screen —
     hide them rather than offering dead controls. */
  [data-slider] :global(.swiper-button-lock) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .slider-pagination :global(.swiper-pagination-bullet) {
      transition: none;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { A11y, Keyboard, Navigation, Pagination } from 'swiper/modules';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // One instance per section, so the component can be dropped onto any page
  // and used more than once.
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((section) => {
    const root = section.querySelector<HTMLElement>('[data-slider-root]');
    const pagination = section.querySelector<HTMLElement>('[data-slider-pagination]');
    const prev = section.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = section.querySelector<HTMLButtonElement>('[data-slider-next]');

    if (!root || !pagination || !prev || !next) return;

    new Swiper(root, {
      modules: [A11y, Keyboard, Navigation, Pagination],
      // Fractional counts leave a peek of the next slide, which reads as a
      // slider rather than a grid.
      slidesPerView: 1.15,
      spaceBetween: 8,
      grabCursor: true,
      watchOverflow: true,
      speed: reducedMotion.matches ? 0 : 600,
      keyboard: { enabled: true, onlyInViewport: true },
      a11y: {
        prevSlideMessage: 'Previous machine',
        nextSlideMessage: 'Next machine',
        paginationBulletMessage: 'Go to machine {{index}}',
        containerRoleDescriptionMessage: 'carousel',
      },
      navigation: { prevEl: prev, nextEl: next },
      pagination: {
        el: pagination,
        clickable: true,
        // Buttons rather than the default spans, so the bullets are reachable
        // by keyboard.
        bulletElement: 'button',
      },
      breakpoints: {
        640: { slidesPerView: 2.15, spaceBetween: 16 },
        1024: { slidesPerView: 3.15, spaceBetween: 16 },
        1536: { slidesPerView: 4, spaceBetween: 22 },
      },
    });
  });
</script>
