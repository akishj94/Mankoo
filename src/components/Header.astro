---
import { getSiteData, whatsappLink } from '../lib/site';
import SmartImage from './SmartImage.astro';
import ThemeToggle from './ThemeToggle.astro';

const { primary, details } = await getSiteData();
const whatsappUrl = whatsappLink(details);

const PANEL_PARENT_URLS = ['/machines'];

const isPanelParent = (url: string) =>
  PANEL_PARENT_URLS.some((prefix) => url === prefix || url.startsWith(`${prefix}/`));

const visibleChildren = (children: { url: string }[]) => children.filter((child) => child.url !== '');

const navLinkBase =
  'rounded-lg px-3 py-2 transition-[background-color,color,backdrop-filter] duration-300 ease-out hover:bg-white/10 hover:backdrop-blur-[5px] focus-visible:bg-white/10 focus-visible:backdrop-blur-[5px] focus-visible:outline-none light:hover:bg-ink/5 light:focus-visible:bg-ink/5 motion-reduce:transition-none';
const navLinkOpen =
  'group-hover/dropdown:bg-white/10 group-hover/dropdown:backdrop-blur-[5px] group-focus-within/dropdown:bg-white/10 group-focus-within/dropdown:backdrop-blur-[5px] light:group-hover/dropdown:bg-ink/5 light:group-focus-within/dropdown:bg-ink/5';

// Plain rows inside the light panels / lists.
const panelRow =
  'block rounded-lg transition-colors duration-200 ease-out hover:bg-[#000a22]/5 focus-visible:bg-[#000a22]/5 focus-visible:outline-none motion-reduce:transition-none';
---

<header
  data-header
  class="group/header fixed inset-x-0 top-0 z-50 isolate text-white light:text-ink data-[menu-open]:bg-ink data-[menu-open]:light:bg-white data-[menu-open]:text-white data-[menu-open]:light:text-ink before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:-z-[1] before:box-content before:h-full before:pb-[10%] before:bg-linear-to-b before:from-[#000a22] before:to-[#000a2200] before:opacity-0 before:transition-opacity before:duration-300 before:ease-out before:content-[''] before:light:from-white before:light:to-[#ffffff00] data-[scrolled]:before:opacity-40 data-[menu-open]:before:hidden motion-reduce:before:transition-none"
>
  <div
    class="container relative z-10 grid h-[var(--header-height)] grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-4"
  >
    <a href="/" class="col-start-1 flex items-center justify-self-start">
      <img
        src="/brand.png"
        alt="Mankoo"
        width="35"
        height="14"
        class="h-5 w-auto light:brightness-0"
      />
    </a>

    <nav class="col-start-2 hidden items-center justify-center gap-2 text-sm min-[992px]:flex" aria-label="Primary">
      {primary.map((item) => {
        const children = visibleChildren(item.children);
        const hasChildren = children.length > 0;
        const showPanel = hasChildren && isPanelParent(item.url);

        return hasChildren ? (
          <div class:list={['group/dropdown', !showPanel && 'relative']} data-nav-dropdown>
            <a href={item.url} class:list={[navLinkBase, navLinkOpen, 'flex cursor-pointer items-center gap-1.5']} aria-haspopup="true">
              {item.label}
              <svg
                width="12"
                height="7"
                viewBox="0 0 12 7"
                fill="none"
                aria-hidden="true"
                class="shrink-0 transition-transform duration-300 ease-out group-hover/dropdown:rotate-180 group-focus-within/dropdown:rotate-180 motion-reduce:transition-none"
              >
                <path d="M1 1.25l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>

            {showPanel ? (
  <div
    role="menu"
    aria-label={`${item.label} submenu`}
    class="absolute left-1/2 top-full z-20 flex w-[min(800px,calc(100vw-2rem))] -translate-x-1/2 translate-y-2 items-start gap-6 rounded-md bg-white p-6 text-ink opacity-0 shadow-[0_32px_80px_-16px_rgba(0,10,34,0.45)] invisible before:absolute before:inset-x-0 before:-top-6 before:h-6 before:content-[''] transition-[opacity,transform,visibility] duration-300 ease-out [transition-behavior:allow-discrete] group-hover/dropdown:visible group-hover/dropdown:translate-y-0 group-hover/dropdown:opacity-100 group-focus-within/dropdown:visible group-focus-within/dropdown:translate-y-0 group-focus-within/dropdown:opacity-100 motion-reduce:transition-none"
  >
    <div class="grid flex-1 grid-cols-2 content-start gap-x-6 gap-y-3">
      {children.map((child) => (
        <a
          href={child.url}
          role="menuitem"
          class="block text-[1.0625rem] leading-[1] font-medium tracking-tight text-ink transition-colors hover:text-accent"
        >
          {child.label}
        </a>
      ))}
    </div>

    {details.menuImage && (
      <div
        class="w-[clamp(240px,30vw,324px)] shrink-0 overflow-hidden rounded-sm bg-ink"
        aria-hidden="true"
      >
        <SmartImage
          src={details.menuImage}
          alt=""
          width={648}
          height={754}
          sizes="(min-width: 992px) 30vw, 0px"
          loading="lazy"
          decoding="async"
          class="aspect-[324/377] size-full object-cover object-center"
        />
      </div>
    )}
  </div>
) : (
              <ul
                class="absolute left-0 top-full z-20 min-w-44 rounded-xl bg-white p-2 pt-[calc(0.5rem+10px)] text-ink opacity-0 shadow-[0_24px_60px_-16px_rgba(0,10,34,0.4)] invisible translate-y-2 transition-[opacity,transform,visibility] duration-300 ease-out [transition-behavior:allow-discrete] group-hover/dropdown:visible group-hover/dropdown:translate-y-0 group-hover/dropdown:opacity-100 group-focus-within/dropdown:visible group-focus-within/dropdown:translate-y-0 group-focus-within/dropdown:opacity-100 motion-reduce:transition-none"
                role="menu"
                aria-label={`${item.label} submenu`}
              >
                {children.map((child) => (
                  <li role="none">
                    <a href={child.url} role="menuitem" class:list={[panelRow, 'px-[0.9rem] py-[0.6rem] text-[0.9375rem] font-semibold tracking-[-0.01em] text-ink']}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ) : (
          <a href={item.url} class={navLinkBase}>
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="col-start-3 flex items-center justify-end gap-1 justify-self-end sm:gap-2">
      <ThemeToggle class="text-white light:text-ink hidden" />
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat with us on WhatsApp"
        class="flex size-10 shrink-0 items-center justify-center rounded-full transition hover:bg-white/5"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.964 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.098-.346-.1-.149-.446-1.102-.616-1.51-.165-.33-.33-.28-.446-.28h-.4c-.132 0-.346.05-.529.247-.181.197-.692.677-.692 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.257.84.41 1.128.527.474.149.907.085 1.25-.05.38-.148 1.17-.479 1.337-.94.165-.46.165-.855.115-.94-.05-.084-.18-.132-.38-.23z"
          />
        </svg>
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        class="relative flex size-8 shrink-0 cursor-pointer items-center justify-center min-[992px]:hidden"
      >
        <span class="absolute left-0 top-1/2 -mt-px h-px w-8 bg-current transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] -translate-y-1 group-data-[menu-open]/header:translate-y-0 group-data-[menu-open]/header:rotate-45 motion-reduce:transition-none"></span>
        <span class="absolute left-0 top-1/2 -mt-px h-px w-8 bg-current transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] translate-y-1 group-data-[menu-open]/header:translate-y-0 group-data-[menu-open]/header:-rotate-45 motion-reduce:transition-none"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    data-mobile-nav
    class="absolute inset-x-0 top-0 z-0 h-[100svh] -translate-y-full overflow-y-auto bg-ink pt-[var(--header-height)] text-white transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] will-change-transform light:bg-white light:text-ink group-data-[menu-open]/header:translate-y-[0%] min-[992px]:hidden motion-reduce:transition-none"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(132.21%_131.76%_at_87.18%_92.97%,#002888_8.85%,#000A22_44.11%)] opacity-0 transition-opacity duration-500 ease-out light:opacity-0 group-data-[menu-open]/header:opacity-100 group-data-[menu-open]/header:light:opacity-0 motion-reduce:transition-none"
      aria-hidden="true"
    ></div>

    <nav class="container relative z-10 flex flex-col pb-6 pt-4 text-sm" aria-label="Mobile">
      {primary.map((item, index) => {
        const children = visibleChildren(item.children);
        const hasChildren = children.length > 0;
        const panelId = `mobile-submenu-${index}`;

        return (
          <div class="border-t border-white/[0.08] first:border-t-0 light:border-ink/10" data-mobile-group>
            <div class="flex items-center justify-between gap-4">
              <a href={item.url} class="flex-1 py-3">
                {item.label}
              </a>
              {hasChildren && (
                <button
                  type="button"
                  data-mobile-submenu-toggle
                  aria-expanded="false"
                  aria-controls={panelId}
                  aria-label={`Show ${item.label} submenu`}
                  class="flex size-11 shrink-0 cursor-pointer items-center justify-center text-white/70 light:text-ink/60"
                >
                  <svg width="12" height="7" viewBox="0 0 12 7" fill="none" aria-hidden="true" class="transition-transform duration-300 ease-out motion-reduce:transition-none">
                    <path d="M1 1.25l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              )}
            </div>

            {hasChildren && (
              <div id={panelId} data-mobile-submenu hidden>
                {children.map((child) => (
                  <a href={child.url} class="block py-2.5 pl-4 text-white/60 light:text-ink/60">
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}
      <div class="mt-4 border-t border-white/[0.08] pt-4 light:border-ink/10">
        <ThemeToggle class="text-white light:text-ink hidden" />
      </div>
    </nav>
  </div>


  <div
    data-desktop-scrim
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-[var(--header-height)] z-0 hidden h-[calc(100svh-var(--header-height))] bg-[#010514]/55 opacity-0 transition-opacity duration-300 ease-out group-has-[[data-nav-dropdown]:hover]/header:opacity-100 group-has-[[data-nav-dropdown]:focus-within]/header:opacity-100 min-[992px]:block motion-reduce:transition-none"
  ></div>
</header>

<style>

  [data-mobile-submenu-toggle][aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
</style>
