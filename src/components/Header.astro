---
const machineLinks = [
  { label: 'Type A', href: '/machines/type-a' },
  { label: 'Type B', href: '/machines/type-b' },
];

// TODO: replace with the real company number — international format, digits only, no "+"
const whatsappNumber = '00000000000';
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  'Hello Mankoo, I would like to know more about your machines.'
)}`;
---

<header data-header class="site-header fixed inset-x-0 top-0 z-50 isolate">
  <div
    class="container relative z-10 grid h-[var(--header-height)] grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-4"
  >
    <a href="/" class="col-start-1 flex items-center justify-self-start">
      <img
        src="/brand.png"
        alt="Mankoo"
        width="35"
        height="14"
        class="h-5 w-auto"
      />
    </a>

    <!-- Desktop navigation (992px and up) -->
    <nav class="col-start-2 hidden items-center justify-center gap-8 text-sm min-[992px]:flex">
      <a href="/about" class="hover:text-neutral-500">About</a>

      <div class="group relative">
        <button
          type="button"
          class="flex items-center gap-1 hover:text-neutral-500"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Machines
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>

        <ul
          class="invisible absolute left-0 top-full mt-2 w-40 rounded-md border border-white/10 bg-[var(--color-body-bg)] py-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
          {machineLinks.map((link) => (
            <li>
              <a href={link.href} class="block px-4 py-2 hover:bg-white/5">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <a href="/news" class="hover:text-neutral-500">News</a>
      <a href="/contact" class="hover:text-neutral-500">Contact</a>
    </nav>

    <div class="col-start-3 flex items-center justify-end gap-3 justify-self-end">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat with us on WhatsApp"
        class="flex size-10 shrink-0 items-center justify-center rounded-full transition hover:bg-white/5"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.964 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.098-.346-.1-.149-.446-1.102-.616-1.51-.165-.33-.33-.28-.446-.28h-.4c-.132 0-.346.05-.529.247-.181.197-.692.677-.692 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.257.84.41 1.128.527.474.149.907.085 1.25-.05.38-.148 1.17-.479 1.337-.94.165-.46.165-.855.115-.94-.05-.084-.18-.132-.38-.23z"
          />
        </svg>
      </a>

      <!-- Menu toggle (below 992px): two dashes, 32px wide, morphing to an X
           when the panel is open. See .menu-bar in global.css. -->
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        class="relative flex size-8 shrink-0 cursor-pointer items-center justify-center min-[992px]:hidden"
      >
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile navigation panel (below 992px). Full-screen and anchored to the
       top of the viewport so it covers the bar too; the bar sits above it via
       z-10. The slide is driven by the .mobile-nav class in global.css — no
       inline transform here, so nothing competes with it. -->
  <div
    id="mobile-nav"
    data-mobile-nav
    class="mobile-nav absolute inset-x-0 top-0 z-0 h-[100svh] overflow-y-auto bg-[var(--color-body-bg)] pt-[var(--header-height)] min-[992px]:hidden"
  >
    <nav class="container flex flex-col gap-1 pb-6 pt-4 text-sm">
      <a href="/about" class="py-2">About</a>
      <a href="/machines" class="py-2">Machines</a>
      {machineLinks.map((link) => (
        <a href={link.href} class="py-2 pl-4 text-white/60">{link.label}</a>
      ))}
      <a href="/news" class="py-2">News</a>
      <a href="/contact" class="py-2">Contact</a>
    </nav>
  </div>
</header>
