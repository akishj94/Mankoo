---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// TODO: the art in src/assets is stand-in line art — swap for real photography.
interface GridImage {
  src: ImageMetadata;
  alt: string;
}

interface Stat {
  value: string;
  /** One array entry per forced line, e.g. ['Years in', 'power', 'presses']. */
  lines: string[];
}

interface Props {
  /** Exactly two: the first fills the small cell, the second the large one. */
  images: GridImage[];
  /** Primary paragraph. */
  lead?: string;
  /** Muted paragraph, rendered after the lead. */
  supporting?: string;
  stats?: Stat[];
  ctaHref?: string;
  /** One entry per forced line in the call to action. */
  ctaLines?: string[];
}

const {
  images,
  lead = 'Mankoo India designs and builds power presses, forging hammers and shearing machines for manufacturers who run them hardest.',
  supporting =
    'From our plant on GT Road, Ludhiana, every machine is designed, machined, assembled and trial-run under one roof — then shipped to production floors across India and more than ten countries.',
  stats = [{ value: '50+', lines: ['Years in', 'power', 'presses'] }],
  ctaHref = '/about',
  ctaLines = ['More About', 'our story'],
} = Astro.props;

const [small, large] = images;
---

<section
  data-split-grid
  class="bg-[radial-gradient(132.21%_131.76%_at_87.18%_92.97%,#002888_8.85%,#000A22_44.11%)] py-24 text-white"
>
  <div class="container grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="grid grid-cols-[61fr_39fr] gap-y-8 lg:gap-y-10" data-reveal>
      <div class="col-start-2 row-start-1 aspect-[1.28/1] overflow-hidden">
        <Image
          src={small.src}
          alt={small.alt}
          width={640}
          height={500}
          sizes="(min-width: 1024px) 20vw, 100vw"
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      </div>

      <div class="col-start-1 row-start-2 aspect-[250/345] overflow-hidden">
        <Image
          src={large.src}
          alt={large.alt}
          width={500}
          height={690}
          sizes="(min-width: 1024px) 30vw, 100vw"
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      </div>
    </div>

    <div data-reveal>
      <p class="text-2xl leading-snug sm:text-3xl">
        {lead}
        <span class="text-white/50"> {supporting}</span>
      </p>

      <div class="mt-12 flex flex-wrap items-center justify-between gap-10">
        {stats.map((stat) => (
          <div>
            <span class="text-4xl font-semibold">{stat.value}</span>
            <p class="mt-1 text-xs uppercase leading-snug tracking-[0.12em] text-white/50">
              {stat.lines.map((line, i) => (
                <Fragment>
                  {i > 0 && <br />}
                  {line}
                </Fragment>
              ))}
            </p>
          </div>
        ))}

        <a
          href={ctaHref}
          class="flex items-center gap-2 rounded-lg bg-white/10 px-5 py-3 text-sm backdrop-blur transition hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <span>
            {ctaLines.map((line, i) => (
              <Fragment>
                {i > 0 && <br />}
                {line}
              </Fragment>
            ))}
          </span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>