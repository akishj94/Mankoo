---
import type { ImageMetadata } from 'astro';
import SmartImage from '../SmartImage.astro';

interface Card {
  href: string;
  image?: ImageMetadata | string;
  alt?: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  viewAllHref?: string;
  viewAllLabel?: string;
  cards: Card[];
}

const {
  eyebrow = '',
  title = '',
  viewAllHref = '',
  viewAllLabel = '',
  cards,
} = Astro.props;
---

<section data-product-grid class="bg-white py-14 text-ink sm:py-16 lg:py-[clamp(76px,5vw,100px)]">
  <div class="container">
    <div class="flex items-end justify-between gap-8" data-reveal>
      <div class="w-full min-w-0 md:max-w-[clamp(60%,80vw,940px)]">
        {eyebrow && (
          <p class="text-[14px] uppercase tracking-[0.2em] text-accent">
            {eyebrow}
          </p>
        )}

        {title && (
          <h2 class="mt-4 text-[32px] leading-[1.08] tracking-tight text-[clamp(30px,4vw,56.5px)]">
            {title}
          </h2>
        )}
      </div>

      {viewAllHref && (
        <a
          href={viewAllHref}
          class="group/view-all inline-flex shrink-0 items-center gap-2 transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
        >
          {viewAllLabel}
        </a>
      )}
    </div>

    <div class="mt-10 sm:mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-14">
      {cards.map((card) => {
        const CardEl = card.href ? 'a' : 'div';
        return (
          <CardEl
            key={card.title}
            href={card.href || undefined}
            class="group/card block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
          >
            <div class="relative aspect-[4/5] w-full overflow-hidden bg-neutral-100 mb-5">
              <SmartImage
                src={card.image}
                alt={card.alt}
                width={800}
                height={1000}
                sizes="(min-width: 1536px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw"
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover/card:scale-105 group-focus-visible/card:scale-105"
              />
            </div>

            {card.title && (
              <h3 class="mt-0 text-[18px] leading-[1.3] tracking-tight text-ink">
                {card.title}
              </h3>
            )}

            {card.description && (
              <p class="mt-3 text-[15px] leading-relaxed text-neutral-600">
                {card.description}
              </p>
            )}
          </CardEl>
        );
      })}
    </div>
  </div>
</section>