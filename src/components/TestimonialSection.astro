---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// TODO: logo and photo are stand-in art in src/assets — swap both for the real
// client mark and a photograph of the press on their floor.
interface Props {
  quote?: string;
  name?: string;
  /** e.g. "Managing Director" */
  role?: string;
  /** e.g. "Brar Auto Components" — appended after the role. */
  company?: string;
  location?: string;
  logo?: ImageMetadata;
  logoAlt?: string;
  image: ImageMetadata;
  imageAlt: string;
}

const {
  quote =
    'Twelve years on the same two presses, and they have never taken an unplanned stop. Build quality you can feel in the frame, and the service team answers on the first ring.',
  name = 'Harjit Singh',
  role = 'Managing Director',
  company = 'Brar Auto Components',
  location = 'Ludhiana',
  logo,
  logoAlt = 'Brar Auto Components logo',
  image,
  imageAlt,
} = Astro.props;
---

<section
  data-testimonial
  class="border-b-2 border-[#242B3C] pb-[clamp(76px,5vw,100px)] text-white"
>
  <div class="container pt-[clamp(48px,4vw,72px)]">
    <!-- fr units rather than percentages: with the 20px gap, 65% + 35% would
         overflow the track by the width of the gap. -->
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[65fr_35fr]" data-reveal>
      <div
        class="flex min-h-[380px] flex-col justify-end bg-[radial-gradient(101.56%_101.56%_at_87.18%_7.03%,#002888_8.85%,#000A22_100%)] p-8 sm:p-10 lg:min-h-[540px] lg:p-14"
      >
        <div class="max-w-[46ch]">
          <blockquote class="text-[20px] leading-[1.4] text-white">
            <p>{quote}</p>
          </blockquote>
          <div class="mt-10">
            <p class="text-[15px] text-white">{name}</p>
            <p class="mt-1 text-[13px] leading-[1.5] text-white/50">
              {role}, {company}<br />
              {location}
            </p>
          </div>

          {logo && (
            <Image
              src={logo}
              alt={logoAlt}
              width={220}
              height={48}
              loading="lazy"
              decoding="async"
              class="mt-8 h-8 w-auto opacity-70"
            />
          )}
        </div>
      </div>

      <!-- lg:min-h-0 lets the cell stretch to the panel beside it instead of
           holding its own height, so the two columns stay flush. -->
      <div class="relative min-h-[300px] overflow-hidden bg-neutral-100 lg:min-h-0">
        <Image
          src={image}
          alt={imageAlt}
          widths={[360, 540, 720]}
          sizes="(min-width: 1024px) 35vw, 100vw"
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      </div>
    </div>
  </div>
</section>