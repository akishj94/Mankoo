---
import { getSiteData } from '../lib/site';

const { columns, social, details } = await getSiteData();

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  details.address
)}`;

// Social profiles live under the "Connect" column. That column is the third of
// the three footer menus; fall back to the last column if an editor renames it,
// so the links always land somewhere sensible. Columns without links render
// nothing.
const connectIndex = columns.findIndex((column) => /^connect$/i.test(column.title.trim()));
const socialColumnIndex = connectIndex === -1 ? columns.length - 1 : connectIndex;

const visibleColumns = columns.filter(
  (column, i) => column.links.length > 0 || (i === socialColumnIndex && social.length > 0)
);

const year = new Date().getFullYear();
---

<footer class="text-white light:text-ink border-t-1 border-[#242B3C] light:border-ink/10">
  <div class="container pb-8 pt-[clamp(56px,5vw,50px)]">
    <div class="flex flex-col gap-y-12 lg:flex-row lg:items-start">
      <div class="lg:w-72 lg:shrink-0">
        <a href="/" class="inline-flex focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:focus-visible:outline-ink">
          <img
            src="/Logo-06.webp"
            alt="Mankoo"
            width="190"
            height="49"
            class="h-8 w-auto brightness-0 invert light:invert-0"
          />
        </a>

        <ul class="mt-6 space-y-3 text-sm text-white/60 light:text-ink/60">
          {details.email && (
            <li>
              <a
                href={`mailto:${details.email}`}
                class="transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:hover:text-ink light:focus-visible:outline-ink"
              >
                {details.email}
              </a>
            </li>
          )}

          {details.address && (
            <li>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block max-w-[34ch] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:hover:text-ink light:focus-visible:outline-ink"
              >
                {details.address}
              </a>
            </li>
          )}

          {details.phones.map((phone) => (
            <li>
              <a
                href={`tel:${phone.number}`}
                class="transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:hover:text-ink light:focus-visible:outline-ink"
              >
                {phone.display}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:ml-auto lg:flex lg:gap-x-16">
        {visibleColumns.map((column) => (
          <nav aria-label={column.title} class="lg:w-44">
            <h2 class="text-sm uppercase text-white/50 light:text-ink/50">
              {column.title}
            </h2>

            <ul class="mt-6 space-y-4 text-sm">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    class="inline-block transition-colors hover:text-white/70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:hover:text-ink/70 light:focus-visible:outline-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>

            {columns[socialColumnIndex] === column && social.length > 0 && (
              <ul class="mt-6 space-y-4 text-sm">
                {social.map((profile) => (
                  <li>
                    <a
                      href={profile.url}
                      target="_blank"
                      rel="noopener noreferrer me"
                      class="inline-block transition-colors hover:text-white/70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:hover:text-ink/70 light:focus-visible:outline-ink"
                    >
                      {profile.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </nav>
        ))}
      </div>
    </div>
  </div>

  <div class="mt-[clamp(40px,4vw,64px)] w-full">
    <div class="container py-6 text-sm text-white/50 light:text-ink/50">
      <div class="flex flex-col text-xs gap-4 sm:flex-row sm:items-center sm:justify-between">
        {details.copyright && <p>© {year} {details.copyright}</p>}

        {details.legalLinks.length > 0 && (
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs">
            {details.legalLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  class="transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white light:hover:text-ink light:focus-visible:outline-ink"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</footer>