---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// The image is imported from src/assets rather than referenced out of public/,
// so Astro can convert it to WebP and emit a responsive srcset.
interface Spec {
  /** Short spec name, e.g. "Capacity". */
  label: string;
  value: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  image: ImageMetadata;
  imageAlt: string;
  specs?: Spec[];
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  eyebrow = 'Featured product',
  title = 'Type A Power Press',
  description =
    'Hot and cold forging presses for continuous, heavy-cycle production — 100 to 500 tonnes, built to run shift after shift.',
  image,
  imageAlt,
  specs = [
    { label: 'Capacity', value: '100T-500T' },
    { label: 'Stroke', value: '100T-500T' },
    { label: 'Stroke per min', value: '100T-500T' },
  ],
  ctaHref = '/machines/type-a',
  ctaLabel = 'Explore the range',
} = Astro.props;
---

<section data-featured class="text-white">
  <div class="container pt-[clamp(48px,4vw,72px)] pb-[clamp(32px,3vw,56px)]">
    <div class="w-full min-w-0 md:max-w-[50%]" data-reveal>
      <p class="text-[14px] uppercase tracking-[0.2em] text-accent">
        {eyebrow}
      </p>

      <h2 class="mt-4 text-[32px] leading-[1.08] tracking-tight sm:text-[30px] md:text-[36px] lg:text-[42.5px]">
        {title}
      </h2>

      <p class="mt-5 text-[15px] leading-[1.2] text-[#616161] md:max-w-[567px]">
        {description}
      </p>
    </div>
  </div>

  <div class="relative">
    <div class="relative isolate min-h-[80vh] w-full overflow-hidden bg-neutral-900">
      <Image
        src={image}
        alt={imageAlt}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 -z-10 size-full object-cover"
      />

      <div
        class="absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/25 to-black/45"
        aria-hidden="true"
      >
      </div>
    </div>

    <div class="relative md:absolute md:inset-x-0 md:bottom-0">
      <div class="container pb-10 pt-10 sm:pb-8 sm:pt-12 md:pb-8 md:pt-0 lg:pb-10" data-reveal>
        
        <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between md:gap-12">
          <div role="list" class="flex flex-col gap-6 md:flex-row md:items-center md:gap-7">
            {specs.map((spec, index) => (
              <Fragment>
                <div
                  role="listitem"
                  class="flex items-baseline justify-between gap-6 border-b border-white/20 pb-4 md:justify-start md:gap-3 md:border-b-0 md:pb-0"
                >
                  <span class="text-xs uppercase tracking-[0.2em] text-white/60">
                    {spec.label}
                  </span>
                  <span class="text-[17px] text-white">{spec.value}</span>
                </div>

                {index < specs.length - 1 && (
                  <span aria-hidden="true" class="hidden text-white/40 md:block">|</span>
                )}
              </Fragment>
            ))}
          </div>

          <!-- Transparent on mobile so it sits flush on the section background;
               from md up it overlays the photo and needs the fill to hold its
               edge against the image. -->
          <a
            href={ctaHref}
            class="inline-flex min-w-[152px] max-w-[246px] items-end justify-center gap-10 rounded-[10px] bg-transparent px-6 py-3 text-[15px] text-white backdrop-blur-[5px] transition-all duration-250 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white md:bg-[rgba(246,246,246,0.2)] md:hover:bg-[rgba(246,246,246,0.35)] min-h-[98px] leading-[1.2]"
          >
            {ctaLabel}
            <svg width="20" height="16" viewBox="0 0 20 16" fill="none" aria-hidden="true">
              <path
                d="M2 8h11.6M8 3.2l5.6 4.8-5.6 4.8"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>